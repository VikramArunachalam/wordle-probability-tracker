# Copy this file to .streamlit/secrets.toml (gitignored, never commit the real
# one) and fill in your Supabase project's Transaction pooler connection
# string -- Project Settings -> Database -> Connection pooling -> "Transaction"
# mode, port 6543 (not the direct connection on port 5432; Supabase's free
# tier caps direct connections low and Streamlit can have several concurrent
# reruns hitting the DB at once).
#
# For the deployed app, add the same thing under Streamlit Community Cloud's
# app settings -> Secrets (separate from this local file).

[connections.supabase]
url = "postgresql+psycopg2://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres"
pool_pre_ping = true
pool_size = 2
